+def _unpack_e64_head_kernel(
+    hidden,
+    total_padded_tokens,
+    total_valid_tokens,
+    expert_start,
+):
+    block_n = 256
+    threads = 256
+
+    @T.prim_func
+    def kernel(
+        head_output: T.Tensor((16, 128, hidden), T.float16),
+        routed_expert_weights: T.Tensor((total_valid_tokens,), T.float32),
+        group_sizes: T.Tensor((64,), T.int32),
+        group_offsets: T.Tensor((65,), T.int32),
+        group_padded_offsets: T.Tensor((65,), T.int32),
+        out: T.Tensor((total_padded_tokens, hidden), T.float16),
+    ):
+        with T.Kernel(16, T.ceildiv(hidden, block_n), threads=threads) as (local_expert_id, bn):
+            expert_id = expert_start + local_expert_id
+            group_size = group_sizes[expert_id]
+            raw_start = group_offsets[expert_id]
+            padded_start = group_padded_offsets[expert_id]
+            for i, j in T.Parallel(128, block_n):
+                if i < group_size:
+                    out[padded_start + i, bn * block_n + j] = (
+                        head_output[local_expert_id, i, bn * block_n + j]
+                        * routed_expert_weights[raw_start + i]
+                    )
+
+    return kernel
+
