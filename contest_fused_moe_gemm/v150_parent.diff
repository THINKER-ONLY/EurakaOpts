+def _unpack_e64_four_chunks_kernel(hidden, total_padded_tokens, total_valid_tokens, expert_block_m):
+    block_n = 256
+    threads = 256
+
+    @T.prim_func
+    def kernel(
+        output0: T.Tensor((16, expert_block_m, hidden), T.float16),
+        output1: T.Tensor((16, expert_block_m, hidden), T.float16),
+        output2: T.Tensor((16, expert_block_m, hidden), T.float16),
+        output3: T.Tensor((16, expert_block_m, hidden), T.float16),
+        routed_expert_weights: T.Tensor((total_valid_tokens,), T.float32),
+        group_sizes: T.Tensor((64,), T.int32),
+        group_offsets: T.Tensor((65,), T.int32),
+        group_padded_offsets: T.Tensor((65,), T.int32),
+        out: T.Tensor((total_padded_tokens, hidden), T.float16),
+    ):
+        with T.Kernel(4, 16, T.ceildiv(hidden, block_n), threads=threads) as (chunk_id, local_expert_id, bn):
+            expert_id = chunk_id * 16 + local_expert_id
+            group_size = group_sizes[expert_id]
+            raw_start = group_offsets[expert_id]
+            padded_start = group_padded_offsets[expert_id]
+            for i, j in T.Parallel(expert_block_m, block_n):
+                if i < group_size:
+                    if chunk_id == 0:
+                        value = output0[local_expert_id, i, bn * block_n + j]
+                    elif chunk_id == 1:
+                        value = output1[local_expert_id, i, bn * block_n + j]
+                    elif chunk_id == 2:
+                        value = output2[local_expert_id, i, bn * block_n + j]
+                    else:
+                        value = output3[local_expert_id, i, bn * block_n + j]
+                    out[padded_start + i, bn * block_n + j] = value * routed_expert_weights[raw_start + i]
+
+    return kernel
+
