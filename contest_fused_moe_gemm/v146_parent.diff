+def _swiglu_slab_kernel(intermediate, slab_start, slab_width, num_experts, expert_block_m):
+    block_n = 256
+    threads = 256
+
+    @T.prim_func
+    def kernel(
+        gate_output: T.Tensor((num_experts, expert_block_m, intermediate), T.float16),
+        up_slab: T.Tensor((num_experts, expert_block_m, slab_width), T.float16),
+        group_offsets: T.Tensor((num_experts + 1,), T.int32),
+    ):
+        with T.Kernel(num_experts, T.ceildiv(slab_width, block_n), threads=threads) as (expert_id, bn):
+            group_size = group_offsets[expert_id + 1] - group_offsets[expert_id]
+            for i, j in T.Parallel(expert_block_m, block_n):
+                if i < group_size:
+                    gate = gate_output[expert_id, i, slab_start + bn * block_n + j]
+                    gate_output[expert_id, i, slab_start + bn * block_n + j] = (
+                        gate * T.sigmoid(gate) * up_slab[expert_id, i, bn * block_n + j]
+                    )
+
+    return kernel
+
