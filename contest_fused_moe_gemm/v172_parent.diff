+@tilelang.jit(
+    pass_configs={
+        tilelang.PassConfigKey.TL_DISABLE_WARP_SPECIALIZED: True,
+        tilelang.PassConfigKey.TL_DISABLE_SAFE_MEMORY_ACCESS: True,
+    }
+)
+def _swiglu_feature_major_e16_kernel(intermediate):
+    block_i = 256
+    threads = 256
+
+    @T.prim_func
+    def kernel(
+        gate_output: T.Tensor((16, intermediate, 192), T.float16),
+        up_output: T.Tensor((16, intermediate, 192), T.float16),
+        group_sizes: T.Tensor((16,), T.int32),
+        activation: T.Tensor((16, intermediate, 192), T.float16),
+    ):
+        with T.Kernel(16, T.ceildiv(intermediate, block_i), threads=threads) as (expert_id, bi):
+            group_size = group_sizes[expert_id]
+            for i, m in T.Parallel(block_i, 192):
+                if m < group_size:
+                    gate = gate_output[expert_id, bi * block_i + i, m]
+                    activation[expert_id, bi * block_i + i, m] = (
+                        gate
+                        * T.sigmoid(gate)
+                        * up_output[expert_id, bi * block_i + i, m]
+                    )
+
+    return kernel
+
+
+@tilelang.jit(
+    pass_configs={
+        tilelang.PassConfigKey.TL_DISABLE_WARP_SPECIALIZED: True,
+        tilelang.PassConfigKey.TL_DISABLE_SAFE_MEMORY_ACCESS: True,
+    }
+)
+def _unpack_feature_major_e16_kernel(hidden, total_padded_tokens, total_valid_tokens):
+    block_h = 256
+    threads = 256
+
+    @T.prim_func
+    def kernel(
+        output_t: T.Tensor((16, hidden, 192), T.float16),
+        routed_expert_weights: T.Tensor((total_valid_tokens,), T.float32),
+        group_sizes: T.Tensor((16,), T.int32),
+        group_offsets: T.Tensor((17,), T.int32),
+        group_padded_offsets: T.Tensor((17,), T.int32),
+        out: T.Tensor((total_padded_tokens, hidden), T.float16),
+    ):
+        with T.Kernel(16, T.ceildiv(hidden, block_h), threads=threads) as (expert_id, bh):
+            group_size = group_sizes[expert_id]
+            raw_start = group_offsets[expert_id]
+            padded_start = group_padded_offsets[expert_id]
+            for h, m in T.Parallel(block_h, 192):
+                if m < group_size:
+                    out[padded_start + m, bh * block_h + h] = (
+                        output_t[expert_id, bh * block_h + h, m]
+                        * routed_expert_weights[raw_start + m]
+                    )
+
+    return kernel
+
