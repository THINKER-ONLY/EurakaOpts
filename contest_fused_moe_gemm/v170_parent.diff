+def _unpack_e16_mgrid_kernel(hidden, total_padded_tokens, total_valid_tokens):
+    block_m = 64
+    block_n = 256
+    threads = 256
+
+    @T.prim_func
+    def kernel(
+        packed_output: T.Tensor((16, 192, hidden), T.float16),
+        routed_expert_weights: T.Tensor((total_valid_tokens,), T.float32),
+        group_sizes: T.Tensor((16,), T.int32),
+        group_offsets: T.Tensor((17,), T.int32),
+        group_padded_offsets: T.Tensor((17,), T.int32),
+        out: T.Tensor((total_padded_tokens, hidden), T.float16),
+    ):
+        with T.Kernel(16, 3, T.ceildiv(hidden, block_n), threads=threads) as (expert_id, bm, bn):
+            group_size = group_sizes[expert_id]
+            raw_start = group_offsets[expert_id]
+            padded_start = group_padded_offsets[expert_id]
+            for i, j in T.Parallel(block_m, block_n):
+                if bm * block_m + i < group_size:
+                    out[padded_start + bm * block_m + i, bn * block_n + j] = (
+                        packed_output[expert_id, bm * block_m + i, bn * block_n + j]
+                        * routed_expert_weights[raw_start + bm * block_m + i]
+                    )
+
+    return kernel
+
