+def _pack_experts_e16_mgrid_kernel(hidden, total_padded_tokens):
+    block_m = 64
+    block_n = 256
+    threads = 256
+
+    @T.prim_func
+    def kernel(
+        stacked_expert_tokens: T.Tensor((total_padded_tokens, hidden), T.float16),
+        group_sizes: T.Tensor((16,), T.int32),
+        group_padded_offsets: T.Tensor((17,), T.int32),
+        packed_input: T.Tensor((16, 192, hidden), T.float16),
+    ):
+        with T.Kernel(16, 3, T.ceildiv(hidden, block_n), threads=threads) as (expert_id, bm, bn):
+            group_size = group_sizes[expert_id]
+            padded_start = group_padded_offsets[expert_id]
+            for i, j in T.Parallel(block_m, block_n):
+                if bm * block_m + i < group_size:
+                    packed_input[expert_id, bm * block_m + i, bn * block_n + j] = (
+                        stacked_expert_tokens[padded_start + bm * block_m + i, bn * block_n + j]
+                    )
+
+    return kernel
+
+
+@tilelang.jit(
+    pass_configs={
+        tilelang.PassConfigKey.TL_DISABLE_WARP_SPECIALIZED: True,
+        tilelang.PassConfigKey.TL_DISABLE_SAFE_MEMORY_ACCESS: True,
+    }
+)
+def _swiglu_e16_mgrid_kernel(intermediate):
+    block_m = 64
+    block_n = 256
+    threads = 256
+
+    @T.prim_func
+    def kernel(
+        gate_output: T.Tensor((16, 192, intermediate), T.float16),
+        up_output: T.Tensor((16, 192, intermediate), T.float16),
+        group_sizes: T.Tensor((16,), T.int32),
+        activation: T.Tensor((16, 192, intermediate), T.float16),
+    ):
+        with T.Kernel(16, 3, T.ceildiv(intermediate, block_n), threads=threads) as (expert_id, bm, bn):
+            group_size = group_sizes[expert_id]
+            for i, j in T.Parallel(block_m, block_n):
+                if bm * block_m + i < group_size:
+                    gate = gate_output[expert_id, bm * block_m + i, bn * block_n + j]
+                    activation[expert_id, bm * block_m + i, bn * block_n + j] = (
+                        gate
+                        * T.sigmoid(gate)
+                        * up_output[expert_id, bm * block_m + i, bn * block_n + j]
+                    )
+
+    return kernel
+
+
+@tilelang.jit(
+    pass_configs={
+        tilelang.PassConfigKey.TL_DISABLE_WARP_SPECIALIZED: True,
+        tilelang.PassConfigKey.TL_DISABLE_SAFE_MEMORY_ACCESS: True,
